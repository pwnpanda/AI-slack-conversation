[Unit]
Description=Bridge Claude Code sessions into Matrix
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/.config/claude-slack-bot/env
WorkingDirectory=%h/git/Private/AI-slack-conversation
ExecStart=%h/git/Private/AI-slack-conversation/.venv/bin/python -m slackbot
Restart=always
RestartSec=3
WatchdogSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
