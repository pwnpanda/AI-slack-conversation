[Unit]
Description=Bridge Claude Code sessions into Matrix
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/.config/claude-slack-bot/env
# Host-agnostic path: each host symlinks ~/.local/share/claude-slack-bot/app
# at its own checkout (see README "Multi-host deployment"). This keeps the
# unit identical across machines whose clone lives at a different path
# (e.g. ~/git/priv/claude-slack-bot vs ~/git/Private/AI-slack-conversation),
# instead of hard-coding either path and breaking the other host on pull.
WorkingDirectory=%h/.local/share/claude-slack-bot/app
ExecStart=%h/.local/share/claude-slack-bot/app/.venv/bin/python -m slackbot
Restart=always
RestartSec=3
WatchdogSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
