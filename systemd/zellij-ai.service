[Unit]
Description=Bring up a detached zellij session named "ai" for claude-slack-bot agent panes
After=default.target

[Service]
# oneshot + RemainAfterExit: the wrapper either spawns zellij detached
# and returns, or no-ops because the session is already up. Either way
# the unit stays "active" — `systemctl restart zellij-ai` re-runs the
# check, which is the desired escape hatch if 'ai' ever dies.
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/zellij-ai-bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
